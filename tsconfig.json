{
    "compilerOptions": {
        "listEmittedFiles": true,
        "target": "es2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "sourceMap": true,
        "declaration": true,
        "outDir": "./lib",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["src", "src/config.ts"],
    "exclude": ["node_modules", "**/__tests__/*"]
}
